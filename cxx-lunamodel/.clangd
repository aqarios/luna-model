# Point clangd at the compile commands generated by `just cpp-test`.
# clangd uses these flags for the .cpp files and infers them for the headers,
# so <luna_model.h> and the wrapper headers resolve while editing.
CompileFlags:
  CompilationDatabase: test/build
  # The SDK is C++20 (plugin.hpp requires it). Pin the standard so headers that
  # aren't part of any TU in the database don't fall back to clangd's older default.
  Add: [-std=c++20]
